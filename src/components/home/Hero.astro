---
import {pathTo} from '@/lib/paths';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-photo" style={`background-image: url('${pathTo('/images/hero-pain.webp')}')`}></div>
  <div class="container hero-content">
    <h1 id="hero-title"><span>Pain Experts So Good,</span> <span>We Don't Want You Coming Back...</span> <span>We Want You Cured!</span></h1>
    <p>We identify and fix the biomechanical cause of your pain—so you can move on with your life</p>
    <div class="hero-actions"><a href={pathTo('/book/')} class="button-primary button-xl">Book a Free Consultation</a></div>
  </div>
</section>
