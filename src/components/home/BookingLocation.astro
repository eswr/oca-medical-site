---
import {site} from '@/config/site';
import {pathTo} from '@/lib/paths';
---
<section class="booking-location"><div class="container booking-grid">
  <div class="booking-card">
    <h2>Book an Appointment</h2>
    <p class="booking-sub">FREE Consultations</p>
    <form class="booking-form" action={site.bookingFormUrl} method="get" target="_blank">
      <label class="sr-only" for="bf-location">Location</label>
      <select id="bf-location" name="location" required>
        <option value="" disabled selected>LOCATION</option>
        <option>Newport Beach</option>
        <option>El Segundo</option>
        <option>Torrance</option>
        <option>Redondo Beach</option>
        <option>Seal Beach</option>
      </select>
      <label class="sr-only" for="bf-first-name">First name</label>
      <input id="bf-first-name" name="first-name" type="text" placeholder="FIRST NAME" autocomplete="given-name" required />
      <label class="sr-only" for="bf-last-name">Last name</label>
      <input id="bf-last-name" name="last-name" type="text" placeholder="LAST NAME" autocomplete="family-name" required />
      <label class="sr-only" for="bf-phone">Phone</label>
      <input id="bf-phone" name="phone" type="tel" placeholder="PHONE" autocomplete="tel" required />
      <label class="sr-only" for="bf-email">Email</label>
      <input id="bf-email" name="email" type="email" placeholder="EMAIL" autocomplete="email" required />
      <small class="booking-privacy">Your information is kept strictly confidential and used only to coordinate your care—we never share or sell your personal or medical details.</small>
      <button type="submit" class="button-green">Schedule Appointment</button>
    </form>
    <p class="booking-note">Submitting opens OCA's existing appointment request form in a new tab.</p>
  </div>
  <div class="location-card location-card-map">
    <img src={pathTo('/images/locations-map.webp')} alt="Map of the Los Angeles South Bay area marking El Segundo, Torrance, Redondo Beach, and Seal Beach" loading="lazy" width="1119" height="794" />
  </div>
</div></section>
