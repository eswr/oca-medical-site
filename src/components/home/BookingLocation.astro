---
import Icon from '@/components/shared/Icon.astro';
import {site} from '@/config/site';
import {pathTo} from '@/lib/paths';
---
<section class="booking-location"><div class="container booking-grid"><div class="booking-card"><p class="eyebrow">LET'S TALK ABOUT YOUR CARE</p><h2>Request an<br/>appointment.</h2><p>Start with a conversation with our team. We can help you understand how to request a visit.</p><div class="booking-actions"><a class="button-navy" href={pathTo('/book/')}>Request an appointment <span aria-hidden="true">↗</span></a><a class="booking-call" href={site.phoneHref}><Icon name="phone" size={18}/> {site.phone}</a></div><small>For emergencies, call 911. Please do not send medical details by regular email.</small></div><div class="location-card"><div class="location-info"><span class="location-dot">●</span><span>OUR OFFICE LOCATION</span><h3>Newport Beach</h3><p>{site.street}<br/>{site.city}, {site.state} {site.zip}</p><a href={site.mapsUrl} target="_blank" rel="noopener noreferrer">Get directions <span aria-hidden="true">↗</span></a></div><div class="location-art" aria-hidden="true"><svg viewBox="0 0 500 330" preserveAspectRatio="xMidYMid slice"><rect width="500" height="330" fill="#e7edf0"/><path d="M-50 265 90 200l70 130-50 90H-50Z" fill="#cadfeb"/><g fill="none" stroke="#fff" stroke-width="13"><path d="M40-20 115 380M158-30l60 370M345-20 294 360M485-20 410 360M-30 85l580 20M-30 194l580-34M-10 294l510-78"/></g><g fill="none" stroke="#b7c6cc" stroke-width="3"><path d="M0 80l490-4M0 270l550-36M255 0l-60 340M394-20l-70 370"/></g><path d="M60 348q80-100 165-99t295 24" stroke="#9cc7b6" stroke-width="34" fill="none"/><path d="M310 145a32 32 0 0 0-32 32c0 23 32 61 32 61s32-38 32-61a32 32 0 0 0-32-32Z" fill="#163889" stroke="#fff" stroke-width="7"/><circle cx="310" cy="177" r="10" fill="#55e5f5"/></svg></div></div></div></section>
