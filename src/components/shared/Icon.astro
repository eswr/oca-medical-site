---
type IconName = 'spine'|'bone'|'heart'|'arrow'|'shield'|'check'|'calendar'|'location'|'phone'|'insurance'|'care'|'people'|'document'|'star';
interface Props { name: IconName; size?: number; strokeWidth?: number; }
const {name, size=36, strokeWidth=1.8}=Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{ name === 'spine' && <><path d="M12 2v20M9 3l3 1 3-1M8 7l4 1 4-1M8 11l4 1 4-1M8 15l4 1 4-1M9 19l3 1 3-1"/><path d="M6 5l2 2-2 2 2 2-2 2 2 2-2 2 3 3M18 5l-2 2 2 2-2 2 2 2-2 2 2 2-3 3"/></> }
{ name === 'bone' && <path d="M17 10a3 3 0 1 0-3-3L7 14a3 3 0 1 0 3 3l7-7Z"/> }
{ name === 'heart' && <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0l-1 1-1-1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/> }
{ name === 'arrow' && <><path d="M5 12h14M13 6l6 6-6 6"/></> }
{ name === 'shield' && <><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></> }
{ name === 'check' && <path d="m4 12 5 5L20 6"/> }
{ name === 'calendar' && <><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 10h18"/></> }
{ name === 'location' && <><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></> }
{ name === 'phone' && <path d="M21 17v3a2 2 0 0 1-2 2C9 22 2 15 2 5a2 2 0 0 1 2-2h3l2 5-2 2a16 16 0 0 0 7 7l2-2 5 2Z"/> }
{ name === 'insurance' && <><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M7 14h5"/></> }
{ name === 'care' && <><circle cx="12" cy="7" r="4"/><path d="M5 22v-2a7 7 0 0 1 14 0v2"/></> }
{ name === 'people' && <><circle cx="9" cy="8" r="3"/><path d="M2 21v-2a7 7 0 0 1 14 0v2M17 5a3 3 0 0 1 0 6M19 16a5 5 0 0 1 3 5"/></> }
{ name === 'document' && <><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 7h6M9 12h6M9 17h4"/></> }
{ name === 'star' && <path d="m12 2 3 6 6.5 1-4.7 4.6 1.1 6.4-5.9-3.1-5.9 3.1 1.1-6.4L2.5 9 9 8l3-6Z"/> }
</svg>
