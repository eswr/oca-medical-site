---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import CTABanner from '@/components/shared/CTABanner.astro';
import {conditions} from '@/data/conditions';
import {pathTo} from '@/lib/paths';
---
<BaseLayout title="Conditions" description="Common pain, joint and spine concerns for which patients may seek an evaluation.">
 <PageHero eyebrow="CONDITIONS" title="Start by understanding what you're experiencing." description="Different symptoms call for different approaches. Explore common reasons patients seek an evaluation."/>
 <section class="section"><div class="container tiles-grid">{conditions.map((item,index)=><a class="info-tile" href={pathTo(`/conditions/${item.slug}/`)}><span class="tile-index">0{index+1}</span><h2>{item.name}</h2><p>{item.summary}</p><span class="tile-arrow" aria-hidden="true">↗</span></a>)}</div></section><CTABanner />
</BaseLayout>
